<?xml version="1.0" encoding="utf-8"?>
<!--
  OVPN 客户端 · Skip Android 模块清单

  说明：
  - 进程入口 `AndroidAppMain` 与宿主 Activity `MainActivity` 由本工程提供
    （见 src/main/kotlin/Main.kt，Skip 官方模板约定，Skip 不会自动生成）。
    这里写**完整类名**而不是 `.Xxx`：Skip 构建插件会把以点开头的相对类名
    按转译模块的 Kotlin 包展开，写全名可避免与 Kotlin 源码包名不一致导致
    「启动即 ClassNotFoundException」。
  - VPN 能力由 `io.github.tim06:openvpn`（OpenVPN 3 内核）提供，
    其 VpnService 与 `BIND_VPN_SERVICE` 权限通过库自带清单自动合并。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络访问：登录主控、获取线路、下载 .ovpn 配置 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- VPN 前台服务常驻（连接期间显示状态通知） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 轻触震动反馈（下拉刷新 / 连接结果，对应 iOS 的 Haptics） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 保证在有 Chrome / 浏览器的设备上能打开支付页 -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name="ovpnpanel.module.AndroidAppMain"
        android:label="OVPN"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">

        <!--
          应用级 Context 注入（剪贴板 / SecurePrefs / 启动浏览器 / VpnService 授权都需要）。
          ContentProvider 在 Application.onCreate 之前实例化，是最可靠的初始化入口。
        -->
        <provider
            android:name="com.ovpn.panel.AppEnvInitializer"
            android:authorities="${applicationId}.appenv"
            android:exported="false" />

        <!-- 承载 Skip 转译后 Compose 界面的宿主 Activity -->
        <activity
            android:name="ovpnpanel.module.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|layoutDirection|locale|mcc|navigation|smallestScreenSize|touchscreen|uiMode"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
