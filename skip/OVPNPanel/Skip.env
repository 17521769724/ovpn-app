// The configuration file for your Skip App (https://skip.tools)
// Properties specified here are shared between Darwin/OVPNPanel.xcconfig and Android/settings.gradle.kts

// The name of the project, which must match the SPM project name in Package.swift
SKIP_PROJECT_NAME = ovpn-panel

// PRODUCT_NAME is the default title of the app (也是 SPM target / 模块名)
PRODUCT_NAME = OVPNPanel

// PRODUCT_BUNDLE_IDENTIFIER is the unique id for both the iOS and Android app
PRODUCT_BUNDLE_IDENTIFIER = com.ovpn.panel

// The semantic version of the app（与改造前保持一致）
MARKETING_VERSION = 1.2.7

// The build number specifying the internal app version（与改造前保持一致）
CURRENT_PROJECT_VERSION = 11

// The package name for the Android entry point, referenced by AndroidManifest.xml
ANDROID_PACKAGE_NAME = com.ovpn.panel
